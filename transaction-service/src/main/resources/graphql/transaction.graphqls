type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
    type: TransactionType!
    transferId: ID
}

enum TransactionType {
    PAYMENT
    DEPOSIT
    TRANSFER_OUT
    TRANSFER_IN
}

type Transfer {
    transferId: ID!
    debit: Transaction!
    credit: Transaction!
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
    currency: String!
}

type Query {
    transactions: [Transaction!]!
    transactionById(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction!]!
}

type Mutation {
    createTransaction(input: TransactionInput!): Transaction!
    transfer(input: TransferInput!): Transfer!
}
