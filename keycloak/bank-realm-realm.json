{
  "realm": "bank-realm",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "USER"
      },
      {
        "name": "ADMIN"
      },
      {
        "name": "AGENT"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bank-front",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "bank-agent",
      "enabled": true,
      "publicClient": false,
      "secret": "bank-agent-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@adria.ma",
      "emailVerified": true,
      "firstName": "user1",
      "lastName": "ADRIA",
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "default-roles-bank-realm"
      ]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@adria.ma",
      "emailVerified": true,
      "firstName": "admin1",
      "lastName": "ADRIA",
      "credentials": [
        {
          "type": "password",
          "value": "1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "default-roles-bank-realm",
        "USER"
      ]
    },
    {
      "username": "service-account-bank-agent",
      "enabled": true,
      "serviceAccountClientId": "bank-agent",
      "realmRoles": [
        "AGENT"
      ]
    }
  ]
}